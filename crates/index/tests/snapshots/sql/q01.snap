---
source: crates/index/tests/queries.rs
expression: dump
---
task: todo, doing
ns: work
tag: urgent
-tag: someday
deadline: < +7d
sort: deadline asc
group: task
---
SELECT b.id, b.page_id, p.name, p.file_path, b.path, b.uid, b.text, b.task_state, b.scheduled, b.scheduled_time, b.deadline, b.deadline_time, b.priority, b.task_state AS grp FROM blocks b JOIN pages p ON p.id = b.page_id WHERE b.task_state IN (?1, ?2) AND (p.key = ?3 OR (p.key >= ?4 AND p.key < ?5)) AND (EXISTS (SELECT 1 FROM refs r WHERE r.src_block_id = b.id AND r.kind = 'tag' AND r.target_key IN (?6)) OR EXISTS (SELECT 1 FROM refs r WHERE r.src_page_id = b.page_id AND r.src_block_id IS NULL AND r.kind = 'tag' AND r.target_key IN (?6))) AND NOT COALESCE((EXISTS (SELECT 1 FROM refs r WHERE r.src_block_id = b.id AND r.kind = 'tag' AND r.target_key IN (?7)) OR EXISTS (SELECT 1 FROM refs r WHERE r.src_page_id = b.page_id AND r.src_block_id IS NULL AND r.kind = 'tag' AND r.target_key IN (?7))), 0) AND b.deadline < ?8 ORDER BY CASE b.task_state WHEN 'doing' THEN 0 WHEN 'todo' THEN 1 WHEN 'waiting' THEN 2 WHEN 'done' THEN 3 WHEN 'canceled' THEN 4 ELSE 5 END, b.deadline IS NULL, b.deadline ASC, b.deadline_time IS NULL, b.deadline_time ASC, p.key, b.id
---
[Text("todo"), Text("doing"), Text("work"), Text("work/"), Text("work0"), Text("urgent"), Text("someday"), Text("2026-10-10")]
