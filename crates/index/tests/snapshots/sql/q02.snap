---
source: crates/index/tests/queries.rs
expression: dump
---
prop.rating: >= 4, any
-prop.status: draft
sort: prop.rating desc
---
SELECT b.id, b.page_id, p.name, p.file_path, b.path, b.uid, b.text, b.task_state, b.scheduled, b.scheduled_time, b.deadline, b.deadline_time, b.priority, NULL AS grp FROM blocks b JOIN pages p ON p.id = b.page_id WHERE (EXISTS (SELECT 1 FROM props x WHERE x.owner_kind = 'block' AND x.owner_id = b.id AND x.key = ?1 AND x.value_num >= ?2) OR EXISTS (SELECT 1 FROM props x WHERE x.owner_kind = 'block' AND x.owner_id = b.id AND x.key = ?3)) AND NOT COALESCE(EXISTS (SELECT 1 FROM props x WHERE x.owner_kind = 'block' AND x.owner_id = b.id AND x.key = ?4 AND x.value_fold = ?5), 0) ORDER BY (SELECT COALESCE(x.value_num, x.value_date, x.value_fold) FROM props x WHERE x.owner_kind = 'block' AND x.owner_id = b.id AND x.key = ?6 ORDER BY x.ord LIMIT 1) IS NULL, (SELECT COALESCE(x.value_num, x.value_date, x.value_fold) FROM props x WHERE x.owner_kind = 'block' AND x.owner_id = b.id AND x.key = ?6 ORDER BY x.ord LIMIT 1) DESC, p.key, b.id
---
[Text("rating"), Real(4.0), Text("rating"), Text("status"), Text("draft"), Text("rating")]
